# Create .env locally and paste the key yourself. Never commit the real value.
DOUBAO_API_KEY=

# Portrait editing: server-only keys. A failed primary edit falls back once.
ZENMUX_API_KEY=
IMAGE_MODEL_ID=openai/gpt-image-2.5-sunburst
ROLLBACK_MODEL=google/gemini-3.1-flash-lite-image

# Local gateway port; 8787 is reserved by Windows on some computers.
PORT=8877
# Account sessions; initialization password must be injected securely, not committed.
AUTH_ADMIN_SECONDS=28800
AUTH_USER_SECONDS=604800
# HTTPS only. Current local HTTP development uses 0.
AUTH_SECURE_COOKIE=0
# Optional absolute overrides; never put provider secrets in these settings.
# AVATAR_PYTHON=P:/path/to/project/.cache/dh-prep-py312/Scripts/python.exe
# AVATAR_WEIGHTS=P:/path/to/project/epoch_40_new.pth
# AVATAR_STORAGE_DIR=P:/path/to/private/avatar-library

# Current Realtime 3.0 contract (verified 2026-08-29).
DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
DOUBAO_MODEL=1.2.6.1
DOUBAO_VOICE=zh_female_vv_jupiter_bigtts

# Optional: keep the first probe short and neutral.
DOUBAO_INSTRUCTIONS=你是一位温和、简洁的中文语音助手。每次回答不超过两句话。
