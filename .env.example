# Create .env locally and paste the key yourself. Never commit the real value.
DOUBAO_API_KEY=

# Server-only image normalization. Never expose this value to Vite/browser code.
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
NORMALIZATION_OUTPUT_DIR=AI_output/normalized

# Current Realtime 3.0 contract (verified 2026-08-29).
DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
DOUBAO_MODEL=1.2.6.1
DOUBAO_VOICE=zh_female_vv_jupiter_bigtts

# Optional: keep the first probe short and neutral.
DOUBAO_INSTRUCTIONS=你是一位温和、简洁的中文语音助手。每次回答不超过两句话。
# Role resource pipeline: safe defaults, no paid calls without separate authorization.
ROLE_ALLOW_PAID=0
ROLE_REPLAY_YOUTH=0
ROLE_OUTPUT_DIR=AI_output/roles
ROLE_PORT=8878
# Set a private random value of at least 16 characters before starting the admin server.
ROLE_ADMIN_TOKEN=
# Optional absolute Python path; platform-specific project venv is otherwise used.
MOTION_PYTHON=
# Optional browser channel (Windows test: msedge); Linux defaults to installed Chromium.
PLAYWRIGHT_CHANNEL=
